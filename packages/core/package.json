{
  "name": "@strangecyan/vignette-core",
  "version": "0.5.0",
  "description": "Target-neutral scene graph, Yoga layout compiler, snapshots, and runtime contracts for Vignette.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changesbyjames/vignette.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "vendor",
    "src/yoga-wasm.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "default": "./dist/builders.js"
    },
    "./stream": {
      "types": "./dist/stream-api.d.ts",
      "default": "./dist/stream-api.js"
    },
    "./sse": {
      "types": "./dist/sse-codec.d.ts",
      "default": "./dist/sse-codec.js"
    },
    "./layout-yoga": {
      "types": "./dist/layout/layout-yoga.d.ts",
      "workerd": "./dist/layout/layout-yoga-workerd.js",
      "default": "./dist/layout/layout-yoga.js"
    },
    "./layout-yoga-wasm": {
      "types": "./dist/layout/layout-yoga-wasm.d.ts",
      "default": "./dist/layout/layout-yoga-wasm.js"
    },
    "./yoga.wasm": {
      "types": "./src/yoga-wasm.d.ts",
      "default": "./vendor/yoga/yoga.wasm"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/core",
    "publish:check": "pnpm publish --dry-run --no-git-checks",
    "vendor:yoga": "node scripts/vendor-yoga.mjs"
  },
  "dependencies": {
    "yoga-layout": "3.2.1",
    "zod": "4.6.5"
  }
}
