{
  "name": "@strangecyan/vignette",
  "version": "2.0.0",
  "description": "Describe a broadcast scene in React. Render it in the browser and in OBS from the same code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changesbyjames/vignette.git",
    "directory": "packages/vignette"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "vignette": "./bin/vignette.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./obs": {
      "types": "./dist/obs/index.d.ts",
      "default": "./dist/obs/index.js"
    },
    "./obs/testing": {
      "types": "./dist/obs/testing.d.ts",
      "default": "./dist/obs/testing.js"
    },
    "./frame": {
      "types": "./dist/frame/index.d.ts",
      "default": "./dist/frame/index.js"
    },
    "./frame/mount": {
      "types": "./dist/frame/mount.d.ts",
      "default": "./dist/frame/mount.js"
    },
    "./bundle": {
      "types": "./dist/bundle/index.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./yoga.wasm": {
      "types": "./vendor/yoga/yoga-wasm.d.ts",
      "default": "./vendor/yoga/yoga.wasm"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/vignette",
    "publish:check": "pnpm publish --dry-run --no-git-checks",
    "vendor:yoga": "node scripts/vendor-yoga.mjs"
  },
  "dependencies": {
    "obs-websocket-js": "5.0.8",
    "react-reconciler": "0.33.0",
    "tinyglobby": "0.2.17",
    "xstate": "5.33.3",
    "yoga-layout": "3.2.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.100.0",
    "playwright": "^1.50.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.105.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-reconciler": "0.33.0",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.4"
  }
}
