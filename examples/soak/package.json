{
  "name": "@vignette/soak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fonts.mjs && node scripts/bundle.mjs",
    "clean": "rm -rf dist public tsconfig.tsbuildinfo",
    "soak": "node dist/harness/soak.js",
    "report": "node dist/harness/report.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@strangecyan/vignette-moq": "workspace:*",
    "hono": "4.12.30",
    "obs-websocket-js": "5.0.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@strangecyan/vignette": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/nunito": "5.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "vite": "8.1.4"
  }
}
