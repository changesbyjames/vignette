FROM node:22-bookworm-slim AS build

WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@11.13.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY packages ./packages
COPY examples/kitchen-sink ./examples/kitchen-sink

RUN pnpm install --frozen-lockfile
RUN pnpm build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    VIGNETTE_STREAM_URL=http://127.0.0.1:4173/stream \
    VIGNETTE_OBS_URL=ws://127.0.0.1:4455

# `@vignette/moq/obs` relays MoQ through the `moq` CLI when OBS has no native `moq_source` input.
ARG TARGETARCH
ARG MOQ_CLI_VERSION=0.14.10
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && case "$TARGETARCH" in arm64) triple=aarch64-unknown-linux-gnu ;; *) triple=x86_64-unknown-linux-gnu ;; esac \
 && release="moq-cli-v${MOQ_CLI_VERSION}-${triple}" \
 && curl -fsSL "https://github.com/moq-dev/moq/releases/download/moq-cli-v${MOQ_CLI_VERSION}/${release}.tar.gz" | tar -xz -C /tmp \
 && install -m 755 "/tmp/${release}/bin/moq" /usr/local/bin/moq \
 && rm -rf "/tmp/${release}" /var/lib/apt/lists/*

WORKDIR /app

# Keep the workspace layout because pnpm's package links point from the example to packages/*.
COPY --from=build --chown=node:node /workspace/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/packages ./packages
COPY --from=build --chown=node:node /workspace/examples/kitchen-sink ./examples/kitchen-sink

USER node

# `vignette obs <stream> --source @vignette/moq/obs`; asset and frame locations come from the stream.
WORKDIR /app/examples/kitchen-sink
CMD ["sh", "-c", "exec node node_modules/vignette/dist/cli/index.js obs \"$VIGNETTE_STREAM_URL\" --obs-url \"$VIGNETTE_OBS_URL\" --password \"$VIGNETTE_OBS_PASSWORD\" --source @vignette/moq/obs"]
